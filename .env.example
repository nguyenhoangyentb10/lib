# B1: Camera source (0=webcam, rtsp://... hoặc /path/to/video.mp4)
CAMERA_SOURCE=0

# B3: Model weights
MODEL_PATH=models/yolov8n.pt

# B5: Zone rectangles — format: x1,y1,x2,y2 (pixel coords)
# Chỉnh sau khi biết độ phân giải camera thực tế
INSIDE_ZONE=200,300,600,500
BUFFER_ZONE=200,220,600,300
OUTSIDE_ZONE=200,100,600,220

# FastAPI server
HOST=0.0.0.0
PORT=8000

# Debug: hiện cửa sổ OpenCV (1=bật, 0=tắt)
SHOW_WINDOW=0
